# ---------------------------------------------------------------------------
# circleftp-jellyfin — server configuration
# Copy to packages/server/.env and edit. Never commit the real file.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=7070
HOST=0.0.0.0

# Prisma connection string. Relative paths are resolved from prisma/.
DATABASE_URL="file:../var/circleftp-jellyfin.db"

# Signs session cookies. REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_DAYS=30
# Set true only if every route to the app is HTTPS. Plain HTTP over Tailscale
# means this must stay false or logins silently fail there.
COOKIE_SECURE=false

# --- Circle FTP ------------------------------------------------------------
CIRCLEFTP_API_BASE=http://new.circleftp.net:5000/api
CIRCLEFTP_IMAGE_BASE=http://new.circleftp.net:5000/uploads
CIRCLEFTP_TIMEOUT_MS=25000

# --- Storage ---------------------------------------------------------------
# The folder Jellyfin watches. On this host it is bind-mounted into the
# container as /media:ro.
MEDIA_ROOT=/var/nextcloud-data/ncadmin/files/Movies
CACHE_DIR=./var/cache

# --- Download tuning -------------------------------------------------------
# Circle FTP hosts are fastest on a single stream; parallelism makes it worse.
DOWNLOAD_CONCURRENCY=1
DOWNLOAD_MAX_ATTEMPTS=8
MIN_FREE_GIB=5
DOWNLOAD_STALL_TIMEOUT_MS=120000

# --- Nextcloud reindex -----------------------------------------------------
# Uses the existing sudoers rule:
#   muz-server ALL=(www-data) NOPASSWD: /usr/bin/php /var/www/nextcloud/occ files\:scan *
NEXTCLOUD_SCAN_ENABLED=true
NEXTCLOUD_DATA_DIR=/var/nextcloud-data
NEXTCLOUD_OCC_PATH=/var/www/nextcloud/occ
NEXTCLOUD_PHP_PATH=/usr/bin/php
NEXTCLOUD_WEB_USER=www-data

# --- Jellyfin rescan -------------------------------------------------------
# Create a key at Jellyfin → Dashboard → API Keys, then flip this on.
JELLYFIN_REFRESH_ENABLED=false
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=

LOG_LEVEL=info
